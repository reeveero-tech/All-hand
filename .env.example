# AGOS Agent Civilization — متغيرات البيئة
# ================================================
# R-041 (D-029): كل متغير أدناه مقروء فعلاً في الكود الحي
# (server.py وagent_civilization/ وagos_kernel/). PYTHON_VERSION في
# render.yaml يستهلكه Render (المنصة) لا كود التطبيق.
# VITE_SUPABASE_* بدائل خلفية يقرأها supabase_store.py عند غياب
# SUPABASE_* — واجهة web/ لا تقرأها (تقرأ VITE_API_BASE فقط في web/src/api.js).

# ============================================================================
# إعدادات الخادم
# ============================================================================

# منفذ الخادم (تضبطه المنصة تلقائياً؛ يقرؤه server.py عند الإقلاع)
PORT=8000

# ============================================================================
# إعدادات الـLLM
# ============================================================================

# مفتاح OpenRouter للتوجيه بالـLLM (agent_civilization/core/llm.py)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# النموذج المستخدم (agent_civilization/core/llm.py)
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# R-116 / D-051: بلا OPENROUTER_API_KEY يُستخدم مزود LLM عام بلا مفتاح (Pollinations)،
# موسوماً keyless:<model>. 0 يعطّله (فتفشل المهام التي تحتاج LLM بخطأ صريح).
AGOS_LLM_KEYLESS=1
# AGOS_LLM_KEYLESS_SPACING_S=6     # أقل فاصل بين استدعاءين (ث)
# AGOS_LLM_KEYLESS_BUDGET_S=90     # ميزانية الاستدعاء الواحد مع إعادات المحاولة (ث)
# AGOS_LLM_KEYLESS_URL=https://text.pollinations.ai/openai
# AGOS_LLM_KEYLESS_MODEL=openai

# ============================================================================
# إعدادات الأمان (R-004)
# ============================================================================

# مفتاح يفعّل المصادقة على /api/tasks و/api/chat و/api/agents/external*
# و/civilization/*. تركه فارغاً = وضع مفتوح (مصادقة معطلة).
# لتوليد مفتاح آمن: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGOS_API_KEY=

# أصول CORS المسموحة (مفصولة بفواصل بلا مسافات). غير مضبوط = "*".
# ترويسة credentials معطلة أثناء استخدام "*". 
AGOS_ALLOWED_ORIGINS=*

# تحديد معدل الطلبات (server.py)
AGOS_RATE_LIMIT_REQUESTS=100
AGOS_RATE_LIMIT_WINDOW=60

# ============================================================================
# إعدادات الحضارة (R-041 / D-029)
# ============================================================================

# عدد الوكلاء لكل تخصص (الافتراضي 50 → 1000 وكيل على 20 تخصصاً).
# يقرؤه server.py عند الإقلاع منذ R-041؛ القيم غير الصالحة تُرفض برسالة
# بدء واضحة. render.yaml يضبط 3 — ملاءمة ذلك للموارد غير مقيسة (Q-013).
AGENTS_PER_SPEC=50

# ============================================================================
# إعدادات Supabase (التخزين الدائم)
# ============================================================================

# رابط مشروع Supabase ومفتاح الخادم (agent_civilization/storage/supabase_store.py)
SUPABASE_URL=https://your-project.supabase.co
# R-042b: المفتاح المفضّل = المفتاح السري (sb_secret_…) أو service_role — جهة الخادم فقط.
# المخطط docs/sql/001_init.sql يفعّل RLS بلا سياسات لـanon، فالمفتاح العام لا يكتب شيئاً.
# لا تضعه أبداً في متغير VITE_ (يُكشف للمتصفح).
SUPABASE_SERVICE_KEY=your_secret_or_service_role_key_here
# بديل للتوافق مع الإعدادات القديمة (يُقرأ إن غاب SUPABASE_SERVICE_KEY):
SUPABASE_ANON_KEY=your_anon_key_here

# بدائل خلفية: يقرأها supabase_store.py عند غياب SUPABASE_*.
# واجهة web/ لا تستخدمها (راجع ملاحظة أعلى الملف).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ============================================================================
# وكلاء خارجيون (اختياري)
# ============================================================================

# وكلاء خارجيون (قائمة JSON؛ agent_civilization/agents/external_adapter.py)
# مثال: [{"name":"my-ollama","url":"http://localhost:11434/v1/chat/completions","model":"llama3","api_key":""}]
# EXTERNAL_AGENTS=

# ============================================================================
# البنية التحتية (agos_kernel/؛ لكلها افتراضيات في الكود)
# ============================================================================

# رابط طابور Redis (agos_kernel/infrastructure/redis_queue.py)
REDIS_URL=redis://localhost:6379

# نطاق مقاييس Prometheus (agos_kernel/infrastructure/metrics.py)
METRICS_NAMESPACE=agos

# ضبط القاطع (agos_kernel/infrastructure/circuit_breaker.py)
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_SUCCESSES=3
CIRCUIT_BREAKER_TIMEOUT=60
CIRCUIT_BREAKER_HALF_OPEN=3

# ============================================================================
# الواجهة (web/)
# ============================================================================

# عنوان API الأساسي لواجهة web/ (web/src/api.js). اتركه فارغاً عند خدمة
# الواجهة من الخادم نفسه (الافتراضي).
# VITE_API_BASE=https://your-deployment.example.com
