# AGOS Agent Civilization - Environment Variables
# ================================================
# R-041 (D-029): every variable below is actually read by the live code
# (server.py, agent_civilization/, agos_kernel/). PYTHON_VERSION in
# render.yaml is consumed by the Render platform, not by application code.
# VITE_SUPABASE_* are BACKEND fallbacks read by supabase_store.py when
# SUPABASE_* is absent — the web/ frontend does not read them (it only
# reads VITE_API_BASE in web/src/api.js).

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server port (auto-set by the platform; read by server.py at startup)
PORT=8000

# ============================================================================
# LLM CONFIGURATION (for AI intelligence)
# ============================================================================

# OpenRouter API key for LLM-powered routing (agent_civilization/core/llm.py)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM model to use (default: free model; agent_civilization/core/llm.py)
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ============================================================================
# SECURITY CONFIGURATION (R-004)
# ============================================================================

# API key enabling auth on /api/tasks, /api/chat, /api/agents/external*,
# and /civilization/*. Leave empty for open mode (auth disabled).
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGOS_API_KEY=

# Allowed CORS origins (comma-separated, no spaces). Leave unset for "*".
# Credentials header is disabled while "*" is in use.
AGOS_ALLOWED_ORIGINS=*

# Rate limiting (server.py)
AGOS_RATE_LIMIT_REQUESTS=100
AGOS_RATE_LIMIT_WINDOW=60

# ============================================================================
# CIVILIZATION CONFIGURATION (R-041 / D-029)
# ============================================================================

# Agents per specialization (default 50 → 1000 agents across 20
# specializations). Read by server.py at startup; invalid values are
# rejected with a clear startup error. render.yaml sets 3 for the free
# plan — that resource-fit choice is unverified (Q-013).
AGENTS_PER_SPEC=50

# ============================================================================
# SUPABASE CONFIGURATION (for persistence)
# ============================================================================

# Supabase project URL and anon key (agent_civilization/storage/supabase_store.py)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Backend fallbacks: read by supabase_store.py when SUPABASE_* is absent.
# NOT used by the web/ frontend (see note at the top of this file).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ============================================================================
# EXTERNAL AGENTS (optional)
# ============================================================================

# External agents (JSON list; agent_civilization/agents/external_adapter.py)
# Example: [{"name":"my-ollama","url":"http://localhost:11434/v1/chat/completions","model":"llama3","api_key":""}]
# EXTERNAL_AGENTS=

# ============================================================================
# INFRASTRUCTURE (agos_kernel/; all have code defaults)
# ============================================================================

# Redis queue URL (agos_kernel/infrastructure/redis_queue.py)
REDIS_URL=redis://localhost:6379

# Prometheus metrics namespace (agos_kernel/infrastructure/metrics.py)
METRICS_NAMESPACE=agos

# Circuit breaker tuning (agos_kernel/infrastructure/circuit_breaker.py)
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_SUCCESSES=3
CIRCUIT_BREAKER_TIMEOUT=60
CIRCUIT_BREAKER_HALF_OPEN=3

# ============================================================================
# FRONTEND (web/)
# ============================================================================

# Base URL of the API for the web/ frontend (web/src/api.js). Leave empty
# when the frontend is served by the same server (default).
# VITE_API_BASE=https://your-deployment.example.com
