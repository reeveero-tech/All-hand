# AGOS Agent Civilization - Environment Variables
# ================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server port (auto-set by Render)
PORT=8000

# ============================================================================
# LLM CONFIGURATION (for AI intelligence)
# ============================================================================

# OpenRouter API key for LLM-powered routing
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM model to use (default: free model)
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# API Key for authentication (optional but recommended for production)
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGOS_API_KEY=

# Allowed CORS origins (comma-separated, no spaces)
# For production, set specific origins instead of "*"
# Example: https://your-domain.com,https://app.your-domain.com
AGOS_ALLOWED_ORIGINS=*

# Rate limiting (requests per time window)
AGOS_RATE_LIMIT_REQUESTS=100
AGOS_RATE_LIMIT_WINDOW=60

# ============================================================================
# CIVILIZATION CONFIGURATION
# ============================================================================

# Agent count per specialization (default: 50)
AGENTS_PER_SPEC=50

# ============================================================================
# SUPABASE CONFIGURATION (for persistence)
# ============================================================================

# Supabase project URL and anon key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Frontend Supabase config (optional)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ============================================================================
# EXTERNAL AGENTS (optional)
# ============================================================================

# External agents (JSON list format)
# Example: [{"name":"my-ollama","url":"http://localhost:11434/v1/chat/completions","model":"llama3","api_key":""}]
# EXTERNAL_AGENTS=
