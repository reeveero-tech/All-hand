import os, sys
os.environ["AGOS_ENV"] = "test"; os.environ["AGENTS_PER_SPEC"] = sys.argv[1] if len(sys.argv) > 1 else "2"
sys.path.insert(0, ".")
from fastapi.testclient import TestClient
import server
c = TestClient(server.app)
h = c.get("/health").json()
print("env AGENTS_PER_SPEC =", os.environ["AGENTS_PER_SPEC"], "| server.AGENTS_PER_SPEC =", server.AGENTS_PER_SPEC,
      "| live agents =", sum(len(p) for p in server.CIVILIZATION.values()))
print("/health checks.civilization:", {k: h["checks"]["civilization"][k] for k in ("status", "message")},
      "agent_count =", h["checks"]["civilization"]["details"].get("agent_count"))
r = c.get("/health/ready"); print("/health/ready", r.status_code, r.json())
s = c.get("/api/system/status").json(); print("/api/system/status total_agents =", s["total_agents"])
