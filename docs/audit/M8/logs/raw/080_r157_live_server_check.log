import json, sys, time, urllib.request
base, key, spec, prompt, data = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], json.loads(sys.argv[5])
H = {"content-type": "application/json", "X-API-Key": key}
def call(m, p, body=None):
    req = urllib.request.Request(base + p, method=m, headers=H, data=None if body is None else json.dumps(body).encode())
    with urllib.request.urlopen(req, timeout=20) as r:
        return r.status, json.loads(r.read())
st, j = call("POST", "/api/tasks", {"specialization": spec, "prompt": prompt, "data": data})
tid = j["task_id"]
for _ in range(100):
    st, t = call("GET", f"/api/tasks/{tid}")
    if t["status"] in ("completed", "failed"): break
    time.sleep(0.1)
res = t.get("result") or {}
inner = res.get("result") if isinstance(res, dict) else None
print(f"POST /api/tasks {spec} -> task status={t['status']} ok={res.get('ok')} impl={res.get('impl', '-')}",
      "result:", json.dumps({k: inner[k] for k in ("ok", "error", "answer") if isinstance(inner, dict) and k in inner})[:160],
      "| experience stored:", bool(((res.get('experience') or {}).get('memory') or {}).get('stored_id')))
