## probe source (/tmp/bench159.py):
"""R-159 overhead probe: in-process POST /api/chat ("analyze numbers ...",
keyword-routed to the real analyst handler, experience memory ON, storage OFF,
LLM OFF), timed per request with perf_counter. One process = one variant x one
round. Not a load test: sequential, single client, in-process ASGI."""
import hashlib, json, logging, os, resource, statistics, sys, time
os.environ.setdefault("AGOS_ENV", "test"); os.environ["AGOS_LLM_KEYLESS"] = "0"
os.environ.pop("OPENROUTER_API_KEY", None); os.environ.pop("SUPABASE_URL", None)
variant, n, warm, logfile = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), sys.argv[4]
sys.path.insert(0, os.getcwd())
if variant == "after_off":
    os.environ["AGOS_TELEMETRY"] = "off"
logging.basicConfig(level=logging.WARNING)
fh = logging.FileHandler(logfile, mode="w")
fh.setLevel(logging.INFO)
lg = logging.getLogger("agos.telemetry"); lg.addHandler(fh); lg.propagate = False
lg.setLevel(logging.WARNING if variant == "after_on_nolog" else logging.INFO)   # nolog: spans+metrics, records not written
from fastapi.testclient import TestClient
import server
from agent_civilization.core.tenancy import Principal
key = "bench-key"; server.CREDENTIALS = {hashlib.sha256(key.encode()).hexdigest(): Principal("bench_tenant", "user")}
server.ENABLE_AUTH = True
H = {"X-API-Key": key}
lat = []
with TestClient(server.app) as c:
    for i in range(warm + n):
        server.request_counts.clear()
        t0 = time.perf_counter()
        r = c.post("/api/chat", json={"message": f"analyze numbers {i % 7} 4 8 15 16 23 42"}, headers=H)
        dt = time.perf_counter() - t0
        assert r.status_code == 200 and r.json()["routed_to"] == "analyst", r.text[:200]
        if i >= warm:
            lat.append(dt * 1000)
fh.flush()
size = os.path.getsize(logfile)
lines = sum(1 for _ in open(logfile))
lat.sort()
print(json.dumps({"variant": variant, "n": n, "warmup": warm,
                  "median_ms": round(statistics.median(lat), 4), "mean_ms": round(statistics.fmean(lat), 4),
                  "p95_ms": round(lat[int(0.95 * len(lat)) - 1], 4), "p99_ms": round(lat[int(0.99 * len(lat)) - 1], 4),
                  "maxrss_kb": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,
                  "telemetry_log_bytes": size, "telemetry_log_lines": lines,
                  "log_bytes_per_request": round(size / (warm + n), 1)}))
