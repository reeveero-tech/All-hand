### /tmp/perf/workers.py (sha256 0d6f06a5fb0d764780d44b2f8c5d36383537bf94b06331afe64d67d1ef89ca1f)
"""RISK-036 probe: CPU ceiling of ONE uvicorn process vs --workers 2 (test-only).
Measures server-side CPU (sum over the uvicorn process tree) and throughput."""
import asyncio, json, os, subprocess, sys, time, tempfile, signal
import aiohttp
CLK = os.sysconf("SC_CLK_TCK")
def tree(pid):
    out=[pid]
    for p in os.listdir("/proc"):
        if p.isdigit():
            try:
                st=open(f"/proc/{p}/stat").read().split()
                if int(st[3])==pid: out.append(int(p))
            except Exception: pass
    return out
def cpu(pids):
    t=0
    for p in pids:
        try:
            st=open(f"/proc/{p}/stat").read().rsplit(")",1)[1].split(); t+=int(st[11])+int(st[12])
        except Exception: pass
    return t/CLK
async def load(url, conc, dur, headers):
    n=0; lat=[]; err=0; end=time.monotonic()+dur
    async with aiohttp.ClientSession(headers=headers) as s:
        async def w():
            nonlocal n, err
            while time.monotonic()<end:
                t=time.perf_counter()
                try:
                    async with s.get(url) as r:
                        await r.read(); ok=r.status==200
                except Exception: ok=False
                lat.append((time.perf_counter()-t)*1000); n+=1; err+= (not ok)
        await asyncio.gather(*[w() for _ in range(conc)])
    lat.sort(); return n, err, lat[len(lat)//2], lat[int(len(lat)*0.95)]
def run(workers, path, port, conc=16, dur=15):
    env={**os.environ,"AGOS_ENV":"test","AGOS_LLM_KEYLESS":"1","AGOS_API_KEY":"test:phase1","AGOS_RATE_LIMIT_REQUESTS":"100000000",
         "AGOS_TOOL_REGISTRY_DB":tempfile.mktemp(suffix=".sqlite3")}
    cmd=[sys.executable,"-m","uvicorn","server:app","--port",str(port),"--log-level","warning"]+(["--workers",str(workers)] if workers>1 else [])
    p=subprocess.Popen(cmd,env=env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    try:
        import urllib.request
        for _ in range(120):
            try: urllib.request.urlopen(f"http://127.0.0.1:{port}/health",timeout=1); break
            except Exception: time.sleep(0.5)
        time.sleep(2)
