{
  "$defs": {
    "AgentOutcome": {
      "additionalProperties": false,
      "description": "runtime_contract.py (R-157): the result of ``agent.execute`` — the same\nshape under AGOS_AGENT_IMPL=real and =specialists (the latter adds\n``impl``). ``specialization`` appears only on the outcome _run_task builds\nwhen no agent could run (BUG-01) or the run ended without one (R-160).",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Agent"
        },
        "elapsed_s": {
          "minimum": 0,
          "title": "Elapsed S",
          "type": "number"
        },
        "experience": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experience"
        },
        "impl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Impl"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/HandlerResult"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "title": "Result"
        },
        "specialization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specialization"
        }
      },
      "required": [
        "ok",
        "agent",
        "elapsed_s",
        "result"
      ],
      "title": "AgentOutcome",
      "type": "object"
    },
    "ExecuteRecord": {
      "additionalProperties": false,
      "description": "A /civilization/execute record in the same memory store (another\nvariant of /api/tasks items). Status is \"completed\" when the plan ran,\nwhatever its stages' ok (no aggregate ok exists — gap G-160-3).",
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "number"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "plan": {
          "additionalProperties": true,
          "title": "Plan",
          "type": "object"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "message",
        "plan",
        "status",
        "created_at",
        "tenant_id"
      ],
      "title": "ExecuteRecord",
      "type": "object"
    },
    "HandlerResult": {
      "additionalProperties": true,
      "description": "What a specialist handler (tool) returns inside ``outcome.result``.\nMeasured keys (20/20 specializations, both impls): ok, answer, error,\ntool_output. Handlers may add keys (open), but these four are typed.",
      "properties": {
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "tool_output": {
          "default": null,
          "title": "Tool Output"
        }
      },
      "required": [
        "ok"
      ],
      "title": "HandlerResult",
      "type": "object"
    },
