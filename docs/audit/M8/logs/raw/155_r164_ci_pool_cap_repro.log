## stress probe source
import asyncio, os, threading, sys
os.environ["AGOS_POOL_WEB_QUEUE"] = "3"
sys.path.insert(0, ".")
from agent_civilization.core import pools
fails = 0
N = 200
for i in range(N):
    pass  # warm pool (threads from the previous burst stay idle)
    gate = threading.Event()
    async def go():
        size = pools.size("web")
        futs = [asyncio.ensure_future(pools.run("web", gate.wait, 5)) for _ in range(size + 3)]
        await asyncio.sleep(0.05)
        busy = sum(1 for f in futs if f.done() and isinstance(f.exception(), pools.PoolBusy))
        gate.set()
        await asyncio.gather(*futs, return_exceptions=True)
        return busy
    if asyncio.run(go()):
        fails += 1
print(f"premature PoolBusy in {fails}/{N} bursts of size+3 calls on a warm pool (cap 3)")
