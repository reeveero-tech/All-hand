import os, sys, asyncio, json
os.environ["AGOS_ENV"]="test"; sys.path.insert(0,".")
from agent_civilization.agents.real import create_civilization, SPECIALIZATIONS
from agent_civilization.core.agents import real_dispatcher
from agent_civilization.core import safety
real = create_civilization(1, impl="real"); spec = create_civilization(1, impl="specialists")
def strip(o):
    o=dict(o); o.pop("elapsed_s",None); o.pop("agent",None); o.pop("impl",None)
    r=o.get("result")
    if isinstance(r,dict):
        r=dict(r)
        for k in ("elapsed_s","duration_s","elapsed_ms","timestamp","fetched_at"): r.pop(k,None)
        o["result"]=r
    return o
CASES={"validator":{"prompt":'{"a":1}'},"analyst":{"prompt":"avg","data":[1,2,3,4]},"db_manager":{"prompt":"CREATE TABLE t(x INTEGER)"}}
async def main():
    same=diff=0
    for s in SPECIALIZATIONS:
        w=CASES.get(s,{"prompt":"demo"})
        a=strip(await real[s][0].execute(dict(w))); b=strip(await spec[s][0].execute(dict(w)))
        eq = json.dumps(a,sort_keys=True,default=str)==json.dumps(b,sort_keys=True,default=str)
        same+=eq; diff+= not eq
        if not eq: print("DIFF", s, json.dumps(a,default=str)[:200], "||", json.dumps(b,default=str)[:200])
    print("success/refusal cases: equal", same, "different", diff)
    orig=real_dispatcher.dispatch
    async def boom(sp, w): raise RuntimeError("internal secret /etc/passwd")
    async def unsafe(sp, w): raise safety.UnsafeURLError("url rejected: private address")
    async def none(sp, w): return None
    for name,fn in (("exception",boom),("unsafe_url",unsafe),("no_handler",none)):
        real_dispatcher.dispatch=fn
        import agent_civilization.agents.real.real_agents as ra; ra._dispatch=fn
        a=await real["analyst"][0].execute({"prompt":"x"}); b=await spec["analyst"][0].execute({"prompt":"x"})
        print(name, "REAL", json.dumps(strip(a)), "| SPEC", json.dumps(strip(b)), "| elapsed keys", "elapsed_s" in a, "elapsed_s" in b)
    real_dispatcher.dispatch=orig
    print("stats real", real["analyst"][0].stats, "spec", spec["analyst"][0].stats)
    print("snapshot keys real", sorted(real["analyst"][0].snapshot()), "spec", sorted(spec["analyst"][0].snapshot()))
asyncio.run(main())
