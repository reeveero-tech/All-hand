## probe: anonymous SSE stream on the old code (/tmp/sec02_old_stream_probe.py)
import asyncio, os, inspect
os.environ.pop("AGOS_API_KEY", None)
import server
async def main():
    sig = inspect.signature(server.event_stream)
    print("event_stream parameters:", list(sig.parameters))
    await server.TASK_EVENTS.put({"type": "task_created", "task_id": "tenant-b-task", "specialization": "analyst"})
    resp = await server.event_stream()          # no key at all
    chunk = await asyncio.wait_for(resp.body_iterator.__anext__(), timeout=3)
    print("anonymous stream status:", resp.status_code, "first chunk:", chunk.strip())
asyncio.run(main())
