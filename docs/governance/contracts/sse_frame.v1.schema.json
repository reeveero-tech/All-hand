  "$id": "agos://contracts/sse_frame/v1",
  "description": "The ``data:`` JSON of one /api/events/stream frame. Since G-160-5\n(D-109) bus events are preceded by an ``id: <epoch>-<generation>-<seq>``\nline; heartbeat/stream_gap/stream_reset frames carry no id. A reconnect\nsending ``Last-Event-ID`` gets the missed events replayed from a bounded\nper-tenant, per-process ring (exact ``stream_gap`` if some were evicted;\n``stream_reset`` if the id is unknown here). No ``event:`` field.",
  "properties": {
    "event": {
      "discriminator": {
        "mapping": {
          "heartbeat": "#/$defs/HeartbeatEvent",
          "stream_gap": "#/$defs/StreamGapEvent",
          "stream_reset": "#/$defs/StreamResetEvent",
          "task_completed": "#/$defs/TaskCompletedEvent",
          "task_created": "#/$defs/TaskCreatedEvent",
          "task_started": "#/$defs/TaskStartedEvent"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TaskCreatedEvent"
        },
        {
          "$ref": "#/$defs/TaskStartedEvent"
        },
        {
          "$ref": "#/$defs/TaskCompletedEvent"
        },
        {
          "$ref": "#/$defs/HeartbeatEvent"
        },
        {
          "$ref": "#/$defs/StreamGapEvent"
        },
        {
          "$ref": "#/$defs/StreamResetEvent"
        }
      ],
      "title": "Event"
    }
  },
  "required": [
    "event"
  ],
  "title": "SSEFrame",
  "type": "object",
  "x-contract-version": 1,
  "x-direction": "stream",
  "x-flow": "/api/events/stream -> client"
}
