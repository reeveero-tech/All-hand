{
  "$id": "agos://contracts/v2/message/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One chat message — one row of agos.messages.",
  "properties": {
    "author_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author Id"
    },
    "content": {
      "maxLength": 200000,
      "title": "Content",
      "type": "string"
    },
    "conversation_id": {
      "format": "uuid",
      "title": "Conversation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "user",
        "assistant",
        "system",
        "tool"
      ],
      "title": "Role",
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "task_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "conversation_id",
    "seq",
    "role",
    "content",
    "created_at"
  ],
  "title": "Message",
  "type": "object",
  "x-contract-version": 1,
  "x-rules": [
    "(conversation_id, seq) is unique"
  ]
}
