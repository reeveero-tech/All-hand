{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "description": "One acceptance criterion of a task or step, checkable by ``check``.",
      "properties": {
        "check": {
          "enum": [
            "tests",
            "sources",
            "recompute",
            "schema",
            "review",
            "human"
          ],
          "title": "Check",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_.-]{1,40}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "check"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "Limits of a task. Absent = no limit beyond the workspace quota (R-207).",
      "properties": {
        "deadline": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_steps": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Steps"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "description": "A declared failure: a stable machine code and a human message.",
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_.]{1,63}$",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    }
  },
  "$id": "agos://contracts/v2/task/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A user goal with acceptance criteria — one row of agos.tasks.",
  "properties": {
    "acceptance_criteria": {
      "items": {
        "$ref": "#/$defs/AcceptanceCriterion"
      },
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "attempts": {
      "default": 0,
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "claim_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claim Token"
    },
    "conversation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Id"
    },
    "cost_usd": {
      "default": 0,
      "minimum": 0,
      "title": "Cost Usd",
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created By"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "goal": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires At"
    },
    "max_attempts": {
      "default": 3,
      "maximum": 20,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "parent_task_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Task Id"
    },
    "priority": {
      "default": 0,
      "maximum": 10,
      "minimum": -10,
      "title": "Priority",
      "type": "integer"
    },
    "result_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Summary"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "default": "queued",
      "enum": [
        "queued",
        "claimed",
        "planning",
        "running",
        "waiting_approval",
        "verifying",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "tokens_in": {
      "default": 0,
      "minimum": 0,
      "title": "Tokens In",
      "type": "integer"
    },
    "tokens_out": {
      "default": 0,
      "minimum": 0,
      "title": "Tokens Out",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "verified_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified At"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "title",
    "goal",
    "created_at",
    "updated_at"
  ],
  "title": "Task",
  "type": "object",
  "x-contract-version": 1,
  "x-rules": [
    "attempts <= max_attempts",
    "status 'completed' requires verified_at",
    "status 'failed' requires error {code, message}",
    "finished_at is set exactly when status is completed, failed or cancelled"
  ]
}
