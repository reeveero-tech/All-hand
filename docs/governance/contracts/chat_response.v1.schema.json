{
  "$defs": {
    "AgentOutcome": {
      "additionalProperties": false,
      "description": "runtime_contract.py (R-157): the result of ``agent.execute`` — the same\nshape under AGOS_AGENT_IMPL=real and =specialists (the latter adds\n``impl``). ``specialization`` appears only on the outcome _run_task builds\nwhen no agent could run (BUG-01) or the run ended without one (R-160).",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Agent"
        },
        "elapsed_s": {
          "minimum": 0,
          "title": "Elapsed S",
          "type": "number"
        },
        "experience": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experience"
        },
        "impl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Impl"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/HandlerResult"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "title": "Result"
        },
        "specialization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specialization"
        }
      },
      "required": [
        "ok",
        "agent",
        "elapsed_s",
        "result"
      ],
      "title": "AgentOutcome",
      "type": "object"
    },
    "HandlerResult": {
      "additionalProperties": true,
      "description": "What a specialist handler (tool) returns inside ``outcome.result``.\nMeasured keys (20/20 specializations, both impls): ok, answer, error,\ntool_output. Handlers may add keys (open), but these four are typed.",
      "properties": {
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "tool_output": {
          "default": null,
          "title": "Tool Output"
        }
      },
      "required": [
        "ok"
      ],
      "title": "HandlerResult",
      "type": "object"
    },
    "Routing": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "llm",
            "keywords"
          ],
          "title": "Method",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "method",
        "reason"
      ],
      "title": "Routing",
      "type": "object"
    }
  },
  "$id": "agos://contracts/chat_response/v1",
  "additionalProperties": false,
  "properties": {
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "duplicate": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duplicate"
    },
    "outcome": {
      "$ref": "#/$defs/AgentOutcome"
    },
    "routed_to": {
      "title": "Routed To",
      "type": "string"
    },
    "routing": {
      "$ref": "#/$defs/Routing"
    },
    "task_id": {
      "pattern": "^[0-9a-f]{12}$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "routed_to",
    "routing",
    "agent",
    "outcome"
  ],
  "title": "ChatResponse",
  "type": "object",
  "x-contract-version": 1,
  "x-direction": "response",
  "x-flow": "POST /api/chat -> client"
}
