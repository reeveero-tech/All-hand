{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agos/tool-registry-contract.schema.json",
  "title": "AGOS Tool Registry Contract — draft",
  "description": "Draft contract for tool metadata. Review and change $id before adoption; a valid record does not prove tool execution or safety.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool_id", "name", "version", "source", "description", "capabilities", "input_schema", "output_schema", "auth_scope", "tenant_scope", "risk_class", "read_only", "idempotent", "requires_approval", "timeout_ms", "health_status", "test_status", "lifecycle_state"],
  "properties": {
    "tool_id": {"type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "string", "minLength": 1},
    "source": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["internal", "mcp", "openapi", "sdk", "cli", "connector", "external"]}, "uri": {"type": "string"}, "revision": {"type": "string"}}},
    "description": {"type": "string", "minLength": 1, "maxLength": 8000},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "input_schema": {"type": "object"},
    "output_schema": {"type": "object"},
    "auth_scope": {"type": "array", "items": {"type": "string"}},
    "tenant_scope": {"enum": ["request_tenant", "system_scoped", "explicit_admin_only", "none"]},
    "risk_class": {"enum": ["low", "medium", "high", "critical"]},
    "side_effects": {"type": "array", "items": {"type": "string"}},
    "read_only": {"type": "boolean"},
    "idempotent": {"type": "boolean"},
    "requires_approval": {"type": "boolean"},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
    "rate_limit": {"type": "object"},
    "resource_budget": {"type": "object"},
    "network_allowlist": {"type": "array", "items": {"type": "string"}},
    "data_classification": {"type": "array", "items": {"type": "string"}},
    "health_status": {"enum": ["unknown", "healthy", "degraded", "unhealthy", "disabled"]},
    "test_status": {"enum": ["not_tested", "contract_pass", "integration_pass", "certified", "failed", "blocked"]},
    "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
    "license": {"type": "string"},
    "docs_uri": {"type": "string"},
    "implementation_ref": {"type": "string"},
    "fallback_policy": {"type": "string"},
    "telemetry_name": {"type": "string"},
    "lifecycle_state": {"enum": ["discovered", "registered", "validated", "certified", "disabled", "deprecated-compatible", "failed"]}
  }
}
